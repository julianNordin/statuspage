root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{cs,csx}]
indent_size = 4

[*.{csproj,props,targets,slnx,xml,bicep,bicepparam}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[*.cs]
# Namespaces: one line, not a block. Two fewer levels of indentation everywhere.
csharp_style_namespace_declarations = file_scoped:error

# var only where the type is already written on the right-hand side.
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Modern C# the analyzers already know how to suggest.
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_prefer_primary_constructors = true:suggestion
csharp_style_prefer_pattern_matching = true:suggestion
csharp_prefer_braces = true:error

# Usings inside the namespace, System first.
csharp_using_directive_placement = outside_namespace:silent
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# An unused using is either a leftover or a mistake. Neither should build.
dotnet_diagnostic.IDE0005.severity = error

# this. is noise when the compiler already knows.
dotnet_style_qualification_for_field = false:error
dotnet_style_qualification_for_property = false:error
dotnet_style_qualification_for_method = false:error

# Readonly by default; a field that is written after construction should say so.
dotnet_style_readonly_field = true:warning

# Naming: interfaces I-prefixed, everything public PascalCase, private fields _camelCase.
dotnet_naming_rule.interfaces_are_prefixed.severity = error
dotnet_naming_rule.interfaces_are_prefixed.symbols = interface_symbols
dotnet_naming_rule.interfaces_are_prefixed.style = prefixed_with_i
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.prefixed_with_i.required_prefix = I
dotnet_naming_style.prefixed_with_i.capitalization = pascal_case

dotnet_naming_rule.private_fields_are_underscored.severity = warning
dotnet_naming_rule.private_fields_are_underscored.symbols = private_field_symbols
dotnet_naming_rule.private_fields_are_underscored.style = underscored_camel_case
dotnet_naming_symbols.private_field_symbols.applicable_kinds = field
dotnet_naming_symbols.private_field_symbols.applicable_accessibilities = private
dotnet_naming_style.underscored_camel_case.required_prefix = _
dotnet_naming_style.underscored_camel_case.capitalization = camel_case

[tests/**/*.cs]
# Test names are sentences. They are read far more often than they are typed.
dotnet_diagnostic.CA1707.severity = none
