<Project>

  <!-- Every project in this repository inherits these. A setting that belongs to one
       project belongs in that project's .csproj; anything here is a claim about all of them. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- InvariantGlobalization is deliberately NOT set. It trims ICU out of the container,
         which is tempting, and Microsoft.Data.SqlClient refuses to start without it:
         "Globalization Invariant Mode is not supported." Collation is a globalization
         concern, so a SQL Server client needs the real tables. -->
  </PropertyGroup>

  <!-- A warning nobody is forced to read is a warning nobody reads. The build fails on them
       instead, which is the only version of "we keep the build clean" that stays true. -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- IDE0005 (unused usings) only reports on build when the documentation file is
         generated - see dotnet/roslyn#41640. The doc file is wanted anyway: OpenAPI reads
         it later. CS1591 stays off, because "every public member needs a doc comment" is a
         rule that produces ceremony rather than explanation. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!-- Deterministic output, so the same source produces the same bytes on a workstation
       and on a build agent. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
